# ── Kendi scraper API'n ──────────────────────────────────────────────────────
SCRAPER_API_URL=https://your-scraper-api.com/profile
SCRAPER_API_KEY=your_key_here          # yoksa boş bırak

# ── Viewer kaynağı ───────────────────────────────────────────────────────────
VIEWER_SOURCE=file                     # "file" veya "api"
VIEWER_FILE_PATH=./viewers.json        # VIEWER_SOURCE=file ise: URL listesi dosyası
VIEWER_API_URL=                        # VIEWER_SOURCE=api ise: endpoint
VIEWER_API_KEY=                        # VIEWER_SOURCE=api ise: api key

# ── Tekrar mesaj gitmesin diye cache ─────────────────────────────────────────
PROCESSED_CACHE_PATH=./processed.json

# ── Heyreach ─────────────────────────────────────────────────────────────────
HEYREACH_API_KEY=your_heyreach_api_key
HEYREACH_CAMPAIGN_COLD_INTRO=campaign_id    # score 60-74
HEYREACH_CAMPAIGN_VALUE_PROP=campaign_id    # score 75-89
HEYREACH_CAMPAIGN_PARTNERSHIP=campaign_id   # score 90+

# ── ICP Kriterleri ───────────────────────────────────────────────────────────
ICP_TARGET_TITLES=Founder,Co-Founder,CEO,CTO,Head of Growth
ICP_TARGET_INDUSTRIES=SaaS,Software,Technology
ICP_TARGET_LOCATIONS=Turkey,Germany,United Kingdom
ICP_COMPANY_SIZE_MIN=10
ICP_COMPANY_SIZE_MAX=500

# ── NOT: Anthropic API key gerekmez! ─────────────────────────────────────────
# Claude Code CLI (claude login) subscription token'ını kullanır.
# Kurulum: npm install -g @anthropic-ai/claude-code && claude login
